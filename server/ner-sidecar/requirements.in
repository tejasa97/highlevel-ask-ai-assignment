# Direct dependencies of the NER sidecar, pinned to the versions it was built and measured with (the PoC .venv311, Python 3.11).
# The lock (requirements.lock, with hashes) is what gets installed; regenerate it after changing this file:
#   uv pip compile requirements.in --generate-hashes --python-version 3.11 --python-platform x86_64-manylinux_2_28 \
#     --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu \
#     --index-strategy unsafe-best-match --emit-index-url -o requirements.lock
# Install: pip install --require-hashes -r requirements.lock
