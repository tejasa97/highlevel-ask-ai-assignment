# Copy to .env and fill in. .env is gitignored.

# Dev only: plan through `claude -p` on your Claude subscription (run `claude auth login` once).
# Not used for benchmark numbers; those need the Anthropic API adapter (not built yet).
PLANNER=claude-cli
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-sonnet-5-5   # Haiku thinks on every call via claude -p, so it is slower here

# Optional local development: set PLANNER=codex-cli and run `codex login` once (ChatGPT sign-in).
# Verified with Codex CLI 0.159.0; uses subscription allowance, without API-key fallback.
CODEX_MODEL=gpt-6.1-sol
CODEX_FAST_MODEL=gpt-6.1-sol
CODEX_REASONING=low
CODEX_FAST_REASONING=low
# CODEX_BIN=/absolute/path/to/codex

# Optional local development: set PLANNER=qwen and use a Qwen Token Plan key (sk-sp-...).
# Token Plan keys only work with the Token Plan base URL, not the pay-as-you-go endpoint.
# QWEN_API_KEY=sk-sp-...
# QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# qwen3.8-flash passed 96% of the planner eval at ~$0.0005/turn list price; qwen3.8-max 97% at ~11x the price.
QWEN_MODEL=qwen3.8-flash
QWEN_FAST_MODEL=qwen3.8-flash
# QWEN_TIMEOUT_MS=120000
# QWEN_THINKING=1   # thinking is off by default; planning doesn't need it
# DeepSeek on the same Token Plan: QWEN_MODEL=deepseek-v4.1-flash-1017 and QWEN_RESPONSE_FORMAT=json_object
# (it has no json_schema mode there). It scored 88% across the three eval suites vs 75% for qwen3.8-flash.
