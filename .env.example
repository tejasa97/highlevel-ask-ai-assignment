# Copy to .env in the repository root and fill in; .env is gitignored. The npm scripts in server/ load it.

# --- Planner ------------------------------------------------------------------------------------
# PLANNER picks the model provider: qwen, claude-cli (the default when unset) or codex-cli.
# BENCHMARK.md was measured with qwen and DeepSeek, as set here.
PLANNER=qwen

# --- qwen: direct HTTP calls to a Qwen Token Plan (OpenAI-compatible) ---------------------------
# Needs a Token Plan key (sk-sp-..., Singapore console). Token Plan keys only work with the Token Plan
# base URL, never a pay-as-you-go endpoint. ALIBABA_TOKEN_PLAN_API_KEY is accepted as an alias.
QWEN_API_KEY=sk-sp-...
# The model the final benchmark ran on. Leave QWEN_RESPONSE_FORMAT unset: the client infers json_object for
# DeepSeek and retries once as json_object if a model rejects json_schema. Unset, QWEN_MODEL is qwen3.8-flash.
QWEN_MODEL=deepseek-v4.1-flash-1017
QWEN_FAST_MODEL=deepseek-v4.1-flash-1017
# QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1   # the default
# QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1              # QwenCloud
# QWEN_TIMEOUT_MS=120000
# QWEN_THINKING=1   # thinking is off by default; planning doesn't need it
# QWEN_RESPONSE_FORMAT=json_schema

# --- claude-cli: `claude -p` on a Claude subscription (run `claude auth login` once) -----------------
# Each call starts a process, so latency is higher than a direct API call; there is no Anthropic API adapter.
# Use the full id: the "haiku" alias is claude-haiku-4-5-20251001 on CLI 2.1.284. The CLI logs
# claude-haiku-5-5 as unrecognized_model but serves it.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- codex-cli: Codex CLI on a ChatGPT subscription (run `codex login` once) ------------------------
# Verified with Codex CLI 0.159.0; uses subscription allowance, without API-key fallback.
CODEX_MODEL=gpt-6.1-sol
CODEX_FAST_MODEL=gpt-6.1-sol
CODEX_REASONING=low
CODEX_FAST_REASONING=low
# CODEX_BIN=/absolute/path/to/codex
# CODEX_HOME=/absolute/path/to/.codex

# --- Other --------------------------------------------------------------------------------------
# PORT=8787          # npm run serve
# RETRIEVAL=bm25     # turn the local embedding model off; the default is hybrid
