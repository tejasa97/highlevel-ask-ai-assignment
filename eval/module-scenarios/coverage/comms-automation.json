    "modules": ["M18"],
    "setup": [
      {
        "fixture": "form",
        "with": {
          "name": "Contact Us",
          "status": "published",
          "publishedAt": "2026-10-15T10:00:00.000Z",
          "fields": [{ "id": "fld_email", "label": "Email", "type": "email", "required": true, "options": [], "validation": { "minLength": null, "maxLength": null, "pattern": null }, "mapsTo": "email" }]
        }
      },
      { "fixture": "formSubmission", "with": { "formId": "fm_1", "values": { "fld_email": "a@example.com" } } },
