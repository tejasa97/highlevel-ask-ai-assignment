[
  {
    "id": "cov-template-create",
    "category": "direct",
    "modules": ["M14"],
    "turns": [{ "user": "Create an email template called Welcome Email with the subject Welcome aboard and the body: Hi {{firstName}}, thanks for joining us." }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M14.A01"] },
      "state": [
        { "sql": "SELECT json_extract(data,'$.channel') FROM message_templates WHERE json_extract(data,'$.name')='Welcome Email'", "equals": "email" },
        { "sql": "SELECT json_extract(data,'$.subject') FROM message_templates WHERE json_extract(data,'$.name')='Welcome Email'", "equals": "Welcome aboard" }
      ]
    }
  },
  {
    "id": "cov-template-preview",
    "category": "direct",
    "modules": ["M14"],
    "setup": [
      {
        "fixture": "messageTemplate",
        "with": {
          "name": "Appointment Reminder",
          "body": "Hi {{firstName}}, see you at {{time}}.",
          "variables": [
            { "name": "firstName", "required": true, "sample": "Ada" },
            { "name": "time", "required": true, "sample": "noon" }
          ]
        }
      }
    ],
    "turns": [{ "user": "Show me the Appointment Reminder template filled in with firstName Grace and time 3pm" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M14.A09"] },
      "reply": { "includes": ["Grace", "3pm"] },
      "noChanges": true
    }
  },
  {
    "id": "cov-template-undeclared-variable",
    "category": "failure",
    "modules": ["M14"],
    "note": "The body uses {{company}} but only firstName is declared, so the check must flag company.",
    "setup": [{ "fixture": "messageTemplate", "with": { "name": "Intro Email", "body": "Hi {{firstName}} from {{company}}", "variables": [{ "name": "firstName", "required": true, "sample": "Ada" }] } }],
    "turns": [{ "user": "Check whether the Intro Email template uses any variables that haven't been declared" }],
    "expect": {
      "actions": { "includes": ["M14.A08"] },
      "reply": { "includes": ["company"] },
      "noChanges": true
    }
  },
  {
    "id": "cov-template-restore-version",
    "category": "direct",
    "modules": ["M14"],
    "note": "Version 2 is current; version 1 had the friendlier wording.",
    "setup": [
      {
        "fixture": "messageTemplate",
        "with": {
          "name": "Follow-up Email",
          "subject": "Checking in",
          "body": "Hi {{firstName}}, buy now.",
          "version": 2,
          "versions": [{ "version": 1, "subject": "Checking in", "body": "Hi {{firstName}}, just checking in.", "at": "2026-10-10T10:00:00.000Z", "by": "us_1" }]
        }
      }
    ],
    "turns": [{ "user": "Go back to the first version of the Follow-up Email template" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M14.A10"] },
      "state": [{ "sql": "SELECT json_extract(data,'$.body') LIKE '%just checking in%' FROM message_templates WHERE json_extract(data,'$.name')='Follow-up Email'", "equals": 1 }]
    }
  },
  {
    "id": "cov-workflow-create-with-wait",
    "category": "multi",
    "modules": ["M16"],
    "turns": [{ "user": "Create a workflow called New Lead Follow-up and give it a wait step of 60 minutes" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M16.A01", "M16.A04"] },
      "state": [
        { "sql": "SELECT count(*) FROM workflows w, json_each(w.data,'$.steps') s WHERE json_extract(w.data,'$.name')='New Lead Follow-up' AND json_extract(s.value,'$.kind')='wait'", "equals": 1 },
        { "sql": "SELECT json_extract(data,'$.status') FROM workflows WHERE json_extract(data,'$.name')='New Lead Follow-up'", "equals": "draft" }
      ]
    }
  },
  {
    "id": "cov-workflow-publish-empty",
    "category": "failure",
    "modules": ["M16"],
    "note": "A workflow with no steps cannot go live.",
    "setup": [{ "fixture": "workflow", "with": { "name": "Empty Flow" } }],
    "turns": [{ "user": "Publish the Empty Flow workflow" }],
    "expect": {
      "state": [{ "sql": "SELECT json_extract(data,'$.status') FROM workflows WHERE json_extract(data,'$.name')='Empty Flow'", "equals": "draft" }],
      "reply": { "includes": ["step"] },
      "noChanges": true
    }
  },
  {
    "id": "cov-workflow-pause",
    "category": "direct",
    "modules": ["M16"],
    "setup": [
      {
        "fixture": "workflow",
        "with": {
          "name": "Welcome Series",
          "status": "published",
          "publishedAt": "2026-10-15T10:00:00.000Z",
          "steps": [{ "id": "step_1", "kind": "wait", "name": "Wait a day", "actionId": null, "args": {}, "waitMinutes": 1440, "condition": null }]
        }
      }
    ],
    "turns": [{ "user": "Pause the Welcome Series workflow" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M16.A09"] },
      "state": [{ "sql": "SELECT json_extract(data,'$.status') FROM workflows WHERE json_extract(data,'$.name')='Welcome Series'", "equals": "paused" }]
    }
  },
  {
    "id": "cov-workflow-run-history",
    "category": "indirect",
    "modules": ["M16"],
    "setup": [
      {
        "fixture": "workflow",
        "with": {
          "name": "Welcome Series",
          "status": "published",
          "publishedAt": "2026-10-15T10:00:00.000Z",
          "steps": [{ "id": "step_1", "kind": "wait", "name": "Wait a day", "actionId": null, "args": {}, "waitMinutes": 1440, "condition": null }]
        }
      },
      { "fixture": "workflowRun", "with": { "workflowId": "wf_1", "status": "completed" } },
      { "fixture": "workflowRun", "with": { "workflowId": "wf_1", "status": "completed" } }
    ],
    "turns": [{ "user": "Has the Welcome Series workflow actually run for anyone yet?" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M16.A10"] },
