  {
    "id": "cov-survey-create-with-rating",
    "category": "multi",
    "modules": ["M19"],
    "turns": [{ "user": "Create a survey called Customer Satisfaction with a 1 to 5 rating question: How satisfied are you with our service?" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M19.A01", "M19.A04"] },
      "state": [
        { "sql": "SELECT json_array_length(data,'$.questions') FROM surveys WHERE json_extract(data,'$.name')='Customer Satisfaction'", "equals": 1 },
        { "sql": "SELECT json_extract(data,'$.questions[0].type') FROM surveys WHERE json_extract(data,'$.name')='Customer Satisfaction'", "equals": "rating" }
      ]
    }
  },
  {
    "id": "cov-survey-publish-then-close",
    "category": "followup",
    "modules": ["M19"],
    "setup": [
      {
        "fixture": "survey",
        "with": { "name": "Customer Satisfaction", "questions": [{ "id": "q_1", "text": "How satisfied are you?", "type": "rating", "options": [], "required": true, "branching": [] }] }
      }
    ],
    "turns": [
      { "user": "Publish the Customer Satisfaction survey", "status": ["done"] },
      { "user": "Actually we have enough answers, close it" }
    ],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M19.A07", "M19.A08"] },
      "state": [{ "sql": "SELECT json_extract(data,'$.status') FROM surveys WHERE json_extract(data,'$.name')='Customer Satisfaction'", "equals": "closed" }]
    }
  },
  {
    "id": "cov-survey-closed-rejects-response",
    "category": "failure",
    "modules": ["M19"],
    "note": "Customer Satisfaction (sv_1) is closed; the response for sv_2 only makes sure the responses table exists.",
    "setup": [
      {
        "fixture": "survey",
        "with": {
          "name": "Customer Satisfaction",
          "status": "closed",
          "publishedAt": "2026-10-10T10:00:00.000Z",
          "closedAt": "2026-10-18T10:00:00.000Z",
          "questions": [{ "id": "q_1", "text": "How satisfied are you?", "type": "rating", "options": [], "required": true, "branching": [] }]
        }
      },
      { "fixture": "survey", "with": { "name": "Event Feedback" } },
      { "fixture": "surveyResponse", "with": { "surveyId": "sv_2" } }
    ],
    "turns": [{ "user": "Submit a test response to the Customer Satisfaction survey with a rating of 5" }],
    "expect": {
      "state": [{ "sql": "SELECT count(*) FROM survey_responses WHERE json_extract(data,'$.surveyId')='sv_1'", "equals": 0 }],
      "reply": { "includes": ["closed"] }
    }
  },
  {
    "id": "cov-survey-response-summary",
    "category": "indirect",
    "modules": ["M19"],
    "setup": [
      {
        "fixture": "survey",
        "with": {
          "name": "Customer Satisfaction",
          "status": "open",
          "publishedAt": "2026-10-10T10:00:00.000Z",
          "questions": [{ "id": "q_1", "text": "How satisfied are you?", "type": "rating", "options": [], "required": true, "branching": [] }]
        }
      },
      { "fixture": "surveyResponse", "with": { "surveyId": "sv_1", "answers": { "q_1": 5 } } },
      { "fixture": "surveyResponse", "with": { "surveyId": "sv_1", "answers": { "q_1": 4 } } },
      { "fixture": "surveyResponse", "with": { "surveyId": "sv_1", "answers": { "q_1": 3 } } }
    ],
    "turns": [{ "user": "How are people rating us in the Customer Satisfaction survey so far?" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M19.A10"] },
      "reply": { "includes": ["\\b3\\b"] },
      "noChanges": true
    }
  }
