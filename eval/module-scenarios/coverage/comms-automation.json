  {
    "id": "cov-trigger-create",
    "category": "direct",
    "modules": ["M17"],
    "turns": [{ "user": "Create an event trigger called New form lead that fires when a form is submitted" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M17.A01"] },
      "state": [
        { "sql": "SELECT json_extract(data,'$.eventType') FROM event_triggers WHERE json_extract(data,'$.name')='New form lead'", "equals": "form.submitted" },
        { "sql": "SELECT json_extract(data,'$.enabled') FROM event_triggers WHERE json_extract(data,'$.name')='New form lead'", "equals": 0 }
      ]
    }
  },
  {
    "id": "cov-trigger-bind-and-enable",
    "category": "multi",
    "modules": ["M17", "M16"],
    "setup": [
      {
        "fixture": "workflow",
        "with": {
          "name": "Welcome Series",
          "status": "published",
          "publishedAt": "2026-10-15T10:00:00.000Z",
          "steps": [{ "id": "step_1", "kind": "wait", "name": "Wait a day", "actionId": null, "args": {}, "waitMinutes": 1440, "condition": null }]
        }
      },
      { "fixture": "eventTrigger", "with": { "name": "Signup trigger", "eventType": "form.submitted" } }
    ],
    "turns": [{ "user": "Connect the Signup trigger to the Welcome Series workflow and switch it on" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M17.A06", "M17.A07"] },
      "state": [
        { "sql": "SELECT json_extract(data,'$.workflowId') FROM event_triggers WHERE json_extract(data,'$.name')='Signup trigger'", "equals": "wf_1" },
        { "sql": "SELECT json_extract(data,'$.enabled') FROM event_triggers WHERE json_extract(data,'$.name')='Signup trigger'", "equals": 1 }
      ]
    }
  },
  {
    "id": "cov-trigger-bind-draft-workflow",
    "category": "failure",
    "modules": ["M17", "M16"],
    "note": "Only a published workflow can be bound to a trigger; Draft Flow is still a draft.",
    "setup": [
      { "fixture": "workflow", "with": { "name": "Draft Flow" } },
      { "fixture": "eventTrigger", "with": { "name": "Signup trigger", "eventType": "form.submitted" } }
    ],
    "turns": [{ "user": "Connect the Signup trigger to the Draft Flow workflow" }],
    "expect": {
      "state": [{ "sql": "SELECT json_extract(data,'$.workflowId') IS NULL FROM event_triggers WHERE json_extract(data,'$.name')='Signup trigger'", "equals": 1 }],
      "noChanges": true
    }
  },
  {
    "id": "cov-trigger-test-event",
    "category": "direct",
    "modules": ["M17"],
    "setup": [
      {
        "fixture": "eventTrigger",
        "with": { "name": "Signup trigger", "eventType": "form.submitted", "conditions": [{ "field": "source", "op": "eq", "value": "facebook_ads" }] }
      }
    ],
    "turns": [{ "user": "Test the Signup trigger with a sample form submission where the source is facebook_ads. Does it match?" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M17.A09"] },
      "state": [{ "sql": "SELECT count(*) FROM trigger_firings WHERE json_extract(data,'$.test')=1", "equals": 1 }]
    }
  },
  {
    "id": "cov-trigger-firing-history",
    "category": "indirect",
    "modules": ["M17"],
    "setup": [
      { "fixture": "eventTrigger", "with": { "name": "Signup trigger", "eventType": "form.submitted" } },
      { "fixture": "triggerFiring", "with": { "triggerId": "trg_1", "eventType": "form.submitted", "matched": true } },
      { "fixture": "triggerFiring", "with": { "triggerId": "trg_1", "eventType": "form.submitted", "matched": false } }
    ],
    "turns": [{ "user": "Has the Signup trigger fired recently?" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M17.A10"] },
      "noChanges": true
    }
  },
  {
    "id": "cov-form-create-with-fields",
    "category": "multi",
    "modules": ["M18"],
    "turns": [{ "user": "Create a form called Contact Us with a required email field and an optional message textarea" }],
    "expect": {
      "status": ["done"],
      "actions": { "includes": ["M18.A01"] },
      "state": [
        { "sql": "SELECT json_array_length(data,'$.fields') FROM forms WHERE json_extract(data,'$.name')='Contact Us'", "equals": 2 },
        { "sql": "SELECT count(*) FROM forms f, json_each(f.data,'$.fields') s WHERE json_extract(f.data,'$.name')='Contact Us' AND json_extract(s.value,'$.type')='email'", "equals": 1 }
      ]
    }
  },
  {
    "id": "cov-form-publish",
