      "expect": { "outcome": "ask", "candidates": ["ct_16", "ld_35"], "pick": "ct_16" }, "answer": "The contact, at Stark." },
    { "id": "dup-assign-femi", "category": "duplicate", "entity": "contact", "intent": "write", "utterance": "Assign Femi Silva to Tom",
      "scope": ["ct", "ld"],
      "expect": { "outcome": "ask", "candidates": ["ct_10", "ld_43"], "pick": "ld_43" }, "answer": "The lead from Acme." },
    { "id": "dup-qualify-kai", "category": "duplicate", "entity": "lead", "intent": "write", "utterance": "Mark Kai Morgan as contacted",
      "setup": [
        { "fixture": "lead", "with": { "name": "Kai Morgan", "email": "kai@morgan-studio.example", "company": "Globex" } },
        { "fixture": "lead", "with": { "name": "Kai Morgan", "email": "kai.morgan@initech.example", "company": "Initech" } }
      ],
      "expect": { "outcome": "ask", "candidates": ["ld_46", "ld_47"], "pick": "ld_47" }, "answer": "The one from Initech." },

    { "id": "typo-note-rosa", "category": "typo", "entity": "contact", "intent": "write", "utterance": "Add a note to Rosa Itto: sent the contract",
      "expect": { "outcome": "ask", "candidates": ["ct_1"], "pick": "ct_1" }, "answer": "Yes, Rosa Ito." },
    { "id": "typo-email-omar", "category": "typo", "entity": "contact", "intent": "read", "utterance": "What's Omar Lassen's email?",
