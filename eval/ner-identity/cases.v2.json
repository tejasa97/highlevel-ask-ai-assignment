      "expect": { "outcome": "bind", "id": "ld_12" } },
    { "id": "email-missing", "category": "email", "entity": "contact", "intent": "read", "utterance": "What's the phone number of nobody@nowhere.example?",
      "scope": ["ct", "ld"],
      "name": "nobody@nowhere.example", "expect": { "outcome": "not_found", "lookalikes": [] } },

