    { "id": "dup-text-sarah-gmail", "category": "duplicate", "entity": "contact", "intent": "write", "utterance": "Text Sarah Johnson: your invoice is ready",
      "expect": { "outcome": "ask", "candidates": ["ct_31", "ct_32"], "pick": "ct_32" }, "answer": "The one with the gmail address." },
    { "id": "dup-email-hiro", "category": "duplicate", "entity": "contact", "intent": "write", "utterance": "Change Hiro Ruiz's email to hiro@ruiz.example",
