{
  "version": 2,
  "about": "Labelled identity-resolution set for workstream D (does NER make the app better?). Runs on the base seed; the few extra records come from per-case fixtures. Labels: bind <id> (act on that record, no question), ask (a question offering exactly `candidates`; the run answers with `answer` and must then act on `pick`), not_found (no such record: act on nothing, say so; a did-you-mean over `lookalikes` is allowed), filter (the name is a filter value or part of a list: answer, no question), create+warn (create the record anyway and warn that one with the same name exists). not_found and create+warn cases carry `name`, the person as the utterance names them: the reply must refer to them. v2 (from v1): `name` added; dup-tag-priya and dup-assign-femi now pick the lead, so the contact-vs-lead duplicates split 2/2. Run with server/src/scripts/eval-ner-identity.ts; see docs/NER-IDENTITY-EVAL.md.",
  "cases": [
    { "id": "agg-stark-count", "category": "aggregate", "entity": "contact", "intent": "read", "utterance": "How many contacts work at Stark?",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["\\b5\\b|\\bfive\\b"] } } },
    { "id": "agg-wayne-leads", "category": "aggregate", "entity": "lead", "intent": "read", "utterance": "How many leads do we have from Wayne?",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["\\b7\\b|\\bseven\\b"] } } },
    { "id": "agg-femi-count", "category": "aggregate", "entity": "contact", "intent": "read", "utterance": "Count the contacts named Femi",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["\\b3\\b|\\bthree\\b"] } } },
    { "id": "agg-acme-count", "category": "aggregate", "entity": "contact", "intent": "read", "utterance": "How many contacts does Acme have?",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["\\b3\\b|\\bthree\\b"] } } },
    { "id": "agg-hooli-leads", "category": "aggregate", "entity": "lead", "intent": "read", "utterance": "List the leads at Hooli",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["Hiro Reyes", "Victor Reyes", "Marco Haddad", "Hiro Ruiz"] } } },
    { "id": "agg-how-many-sarahs", "category": "aggregate", "entity": "contact", "intent": "read", "utterance": "How many Sarah Johnsons are in our contacts?",
      "note": "The duplicate name is the filter here: counting them needs no question.",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["\\b2\\b|\\btwo\\b"] } } },

    { "id": "create-rosa-ito", "category": "create-existing", "entity": "contact", "intent": "write", "utterance": "Add a new contact Rosa Ito, rosa.ito@gmail.example",
      "name": "Rosa Ito", "expect": { "outcome": "create+warn", "existing": ["ct_1"] }, "answer": "Yes, create a separate new contact.",
      "check": { "state": [{ "sql": "SELECT count(*) FROM contacts WHERE json_extract(data,'$.name')='Rosa Ito'", "equals": 2 }] } },
    { "id": "create-marcus-lee", "category": "create-existing", "entity": "contact", "intent": "write", "utterance": "Create a contact called Marcus Lee from Lee & Co, phone +15550199999",
      "name": "Marcus Lee", "expect": { "outcome": "create+warn", "existing": ["ct_33"] }, "answer": "Yes, create a separate new contact.",
      "check": { "state": [{ "sql": "SELECT count(*) FROM contacts WHERE json_extract(data,'$.name')='Marcus Lee'", "equals": 2 }] } },
    { "id": "create-priya-lead", "category": "create-existing", "entity": "lead", "intent": "write", "utterance": "Add Priya Haddad as a new lead from Globex",
      "name": "Priya Haddad", "expect": { "outcome": "create+warn", "existing": ["ld_12", "ct_12"] }, "answer": "Yes, create a separate new lead.",
      "check": { "state": [{ "sql": "SELECT count(*) FROM leads WHERE json_extract(data,'$.name')='Priya Haddad'", "equals": 2 }] } },
    { "id": "create-zoe-costa", "category": "create-existing", "entity": "contact", "intent": "write", "utterance": "Create a new contact Zoe Costa at Initech",
      "name": "Zoe Costa", "expect": { "outcome": "create+warn", "existing": ["ct_26", "ct_30"] }, "answer": "Yes, create a separate new contact.",
      "check": { "state": [{ "sql": "SELECT count(*) FROM contacts WHERE json_extract(data,'$.name')='Zoe Costa'", "equals": 3 }] } },
    { "id": "create-hiro-ruiz-lead", "category": "create-existing", "entity": "lead", "intent": "write", "utterance": "New lead: \"Hiro Ruiz\", hiro@ruiz.example",
      "name": "Hiro Ruiz", "expect": { "outcome": "create+warn", "existing": ["ld_35", "ct_16"] }, "answer": "Yes, create a separate new lead.",
      "check": { "state": [{ "sql": "SELECT count(*) FROM leads WHERE json_extract(data,'$.name')='Hiro Ruiz'", "equals": 2 }] } },

    { "id": "quoted-note-rosa", "category": "quoted", "entity": "contact", "intent": "write", "utterance": "Add a note to \"Rosa Ito\": prefers calls after 3pm",
      "expect": { "outcome": "bind", "id": "ct_1" } },
    { "id": "quoted-tag-elena", "category": "quoted", "entity": "contact", "intent": "write", "utterance": "Tag \"Elena Costa\" as vip",
      "expect": { "outcome": "bind", "id": "ct_2" } },
    { "id": "quoted-task-marcus", "category": "quoted", "entity": "contact", "intent": "write", "utterance": "Create a task to call \"Marcus Lee\" tomorrow",
      "expect": { "outcome": "bind", "id": "ct_33" } },
    { "id": "quoted-email-ana", "category": "quoted", "entity": "contact", "intent": "read", "utterance": "What's the email of 'Ana Ruiz'?",
      "expect": { "outcome": "bind", "id": "ct_3" }, "check": { "reply": { "includes": ["ana\\.ruiz@stark\\.example"] } } },
    { "id": "quoted-show-sarah", "category": "quoted", "entity": "contact", "intent": "read", "utterance": "Show me the contacts called \"Sarah Johnson\"",
      "note": "Listing both duplicates is the answer; asking which one would be needless.",
      "expect": { "outcome": "filter" }, "check": { "reply": { "includes": ["brightside", "gmail"] } } },

    { "id": "body-email-rosa", "category": "message-body", "entity": "contact", "intent": "write", "utterance": "Email Rosa Ito: Tara Larsen will join our call on Friday",
      "note": "Tara Larsen (ct_9) is only in the body.",
      "expect": { "outcome": "bind", "id": "ct_1" } },
    { "id": "body-note-kofi", "category": "message-body", "entity": "contact", "intent": "write", "utterance": "Add a note to Kofi Haddad saying Sarah Johnson referred him",
      "note": "The duplicate Sarah Johnson in the body must not trigger a question.",
      "expect": { "outcome": "bind", "id": "ct_25" } },
    { "id": "body-task-marco", "category": "message-body", "entity": "contact", "intent": "write", "utterance": "Create a task for Tom to call Marco Patel about the renewal Nina Novak mentioned",
      "note": "Nina Novak (contact ct_24 and lead ld_39) is only in the task text.",
      "scope": ["ct", "ld"],
      "expect": { "outcome": "bind", "id": "ct_4" } },
    { "id": "body-text-sarah-zoe", "category": "message-body", "entity": "contact", "intent": "write", "utterance": "Text Sarah Johnson at Brightside: Zoe Costa says hi",
      "expect": { "outcome": "bind", "id": "ct_31" } },
    { "id": "body-email-elena", "category": "message-body", "entity": "contact", "intent": "write", "utterance": "Send Elena Costa an email saying Marcus Lee from Lee & Co will call her",
      "expect": { "outcome": "bind", "id": "ct_2" } },

    { "id": "missing-marta-patel", "category": "missing-lookalike", "entity": "contact", "intent": "read", "utterance": "What's Marta Patel's email?",
      "scope": ["ct", "ld"],
      "name": "Marta Patel", "expect": { "outcome": "not_found", "lookalikes": ["ct_4", "ct_27", "ld_5", "ld_22"] }, "check": { "reply": { "excludes": ["marco\\.patel@", "ben\\.patel@"] } } },
    { "id": "missing-rosalind-ito", "category": "missing-lookalike", "entity": "contact", "intent": "write", "utterance": "Add a note to Rosalind Ito: called back",
      "name": "Rosalind Ito", "expect": { "outcome": "not_found", "lookalikes": ["ct_1"] }, "check": { "noChanges": true } },
    { "id": "missing-victor-browning", "category": "missing-lookalike", "entity": "contact", "intent": "write", "utterance": "Tag Victor Browning as vip",
      "name": "Victor Browning", "expect": { "outcome": "not_found", "lookalikes": ["ct_8"] }, "check": { "noChanges": true } },
    { "id": "missing-jonathan-novak", "category": "missing-lookalike", "entity": "contact", "intent": "write", "utterance": "Text Jonathan Novak that his order shipped",
      "scope": ["ct", "ld"],
      "name": "Jonathan Novak", "expect": { "outcome": "not_found", "lookalikes": ["ct_18", "ct_24", "ct_28", "ld_33", "ld_39"] }, "check": { "noChanges": true } },
    { "id": "missing-dana-whitfield", "category": "missing-lookalike", "entity": "contact", "intent": "write", "utterance": "Assign Dana Whitfield to Aisha",
      "scope": ["ct", "ld"],
      "note": "No lookalike at all: any question is needless.",
      "name": "Dana Whitfield", "expect": { "outcome": "not_found", "lookalikes": [] }, "check": { "noChanges": true } },
    { "id": "missing-quincy-reyes", "category": "missing-lookalike", "entity": "lead", "intent": "write", "utterance": "Mark the lead Quincy Reyes as contacted",
      "name": "Quincy Reyes", "expect": { "outcome": "not_found", "lookalikes": ["ld_19"] }, "check": { "noChanges": true } },

    { "id": "dup-note-sarah", "category": "duplicate", "entity": "contact", "intent": "write", "utterance": "Add a note to Sarah Johnson: wants a demo next week",
      "expect": { "outcome": "ask", "candidates": ["ct_31", "ct_32"], "pick": "ct_31" }, "answer": "The one at Brightside." },
    { "id": "dup-owner-zoe", "category": "duplicate", "entity": "contact", "intent": "write", "utterance": "Make Aisha the owner of Zoe Costa",
