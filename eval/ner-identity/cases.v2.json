      "check": { "reply": { "includes": ["omar\\.larsen@hooli\\.example"] } } },
    { "id": "typo-tag-elena", "category": "typo", "entity": "contact", "intent": "write", "utterance": "Tag Elena Costta as vip",
      "expect": { "outcome": "ask", "candidates": ["ct_2"], "pick": "ct_2" }, "answer": "Yes, Elena Costa." },
    { "id": "typo-task-marcus", "category": "typo", "entity": "contact", "intent": "write", "utterance": "Create a task to call Marcus Lea on Monday",
      "expect": { "outcome": "ask", "candidates": ["ct_33"], "pick": "ct_33" }, "answer": "Yes, Marcus Lee." },
    { "id": "typo-assign-yusuf", "category": "typo", "entity": "contact", "intent": "write", "utterance": "Assign Yusef Silva to Raj",
      "expect": { "outcome": "ask", "candidates": ["ct_5"], "pick": "ct_5" }, "answer": "Yes, Yusuf Silva." },
    { "id": "typo-lead-grace", "category": "typo", "entity": "lead", "intent": "write", "utterance": "Mark the lead Grace Patell as contacted",
      "expect": { "outcome": "ask", "candidates": ["ld_5"], "pick": "ld_5" }, "answer": "Yes, Grace Patel." },

    { "id": "email-note-rosa", "category": "email", "entity": "contact", "intent": "write", "utterance": "Add a note to rosa.ito@acme.example: renewal due in March",
